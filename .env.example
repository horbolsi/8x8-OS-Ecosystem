# 8x8 Hub Environment Variables
# Copy this to .env and fill in your values. Never commit real secret values.

# Database / durable Genesis reservation ledger
DATABASE_URL=postgresql://user:pass@localhost:5432/hub_db

# Hosted payment checkout (server-side only)
STRIPE_SECRET_KEY=sk_live_or_test_value_set_only_in_runtime_secret_store
STRIPE_WEBHOOK_SECRET=whsec_optional_until_durable_webhook_ingestion_is_enabled
EIGHTX8_PUBLIC_BASE_URL=https://8x8-os-ecosystem.vercel.app

# Server
HUB_PORT=3000
NODE_ENV=production
ADMIN_SECRET=change_me_in_production

# Telegram
TG_BOT_TOKEN=your_telegram_bot_token

# AI Providers
ELEVENLABS_API_KEY=your_elevenlabs_key
FAL_KEY=your_fal_key
OPENROUTER_API_KEY=your_openrouter_key

# Trading
BITGET_API_KEY=your_bitget_key
BITGET_SECRET_KEY=your_bitget_secret
BITGET_PASSPHRASE=your_bitget_passphrase

# CORS / three-horizon development carriers
ALLOWED_ORIGINS=http://localhost:8008,http://localhost:8080,http://localhost:8888,http://localhost:3000
