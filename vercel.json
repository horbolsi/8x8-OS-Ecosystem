{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {"source": "/_8x8/release", "destination": "/release-identity.json"},
    {"source": "/_8x8/telegram-release", "destination": "/telegram-release-identity.json"},
    {"source": "/one-fabric", "destination": "/one-fabric/index.html"},
    {"source": "/one-fabric/", "destination": "/one-fabric/index.html"},
    {"source": "/payment/success", "destination": "/payment/success/index.html"},
    {"source": "/payment/success/", "destination": "/payment/success/index.html"},
    {"source": "/telegram", "destination": "/telegram/index.html"},
    {"source": "/telegram/", "destination": "/telegram/index.html"},
    {"source": "/join", "destination": "/join/index.html"},
    {"source": "/join/", "destination": "/join/index.html"},
    {"source": "/styles.css", "destination": "/telegram/styles.css"},
    {"source": "/app.js", "destination": "/telegram/app.js"},
    {"source": "/feature-registry.js", "destination": "/telegram/feature-registry.js"},
    {"source": "/", "destination": "/one-fabric/index.html"},
    {"source": "/stable", "destination": "/stable/index.html"},
    {"source": "/stable/", "destination": "/stable/index.html"},
    {"source": "/world", "destination": "/one-fabric/index.html"},
    {"source": "/first-blink", "destination": "/one-fabric/index.html"},
    {"source": "/first-blink/", "destination": "/one-fabric/index.html"},
    {"source": "/r6", "destination": "/r6/index.html"},
    {"source": "/r6/", "destination": "/r6/index.html"},
    {"source": "/ssi", "destination": "/ssi/index.html"},
    {"source": "/ssi/", "destination": "/ssi/index.html"},
    {"source": "/genesis", "destination": "/genesis/index.html"},
    {"source": "/genesis/", "destination": "/genesis/index.html"},
    {"source": "/r3", "destination": "/r3/index.html"},
    {"source": "/r3/", "destination": "/r3/index.html"},
    {"source": "/r4", "destination": "/r4/index.html"},
    {"source": "/r4/", "destination": "/r4/index.html"},
    {"source": "/r5", "destination": "/r5/index.html"},
    {"source": "/r5/", "destination": "/r5/index.html"},
    {"source": "/art-board", "destination": "/r6/index.html"},
    {"source": "/((?!.*\\.).*)", "destination": "/one-fabric/index.html"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"},
        {"key": "Cross-Origin-Opener-Policy", "value": "same-origin"},
        {"key": "Cross-Origin-Resource-Policy", "value": "same-origin"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'; upgrade-insecure-requests"},
        {"key": "X-8X8-Release-Identity", "value": "STABLE-0.5.0-ONE-FABRIC-FULL-INTERFACE"},
        {"key": "X-8X8-Public-Private-Boundary", "value": "PUBLIC-PRODUCT-NO-OWNER-RUNTIME"},
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}
      ]
    },
    {"source": "/", "headers": [
      {"key": "Cache-Control", "value": "no-store, max-age=0"},
      {"key": "X-8X8-Release-Channel", "value": "stable-one-fabric"},
      {"key": "X-8X8-Product-Stable", "value": "true"},
      {"key": "X-8X8-Financial-Sale-Open", "value": "false"},
      {"key": "X-8X8-Payment-Blocker", "value": "STRIPE-CHARGES-DISABLED-AND-SERVER-SECRET-MISSING"},
      {"key": "X-8X8-Mainnet-Live", "value": "false"}
    ]},
    {"source": "/one-fabric(.*)", "headers": [
      {"key": "Cache-Control", "value": "no-store, max-age=0"},
      {"key": "X-8X8-Release-Identity", "value": "ONE-FABRIC-FULL-INTERFACE-PAYMENTS-V1"},
      {"key": "X-8X8-Release-Channel", "value": "stable-one-fabric"},
      {"key": "X-8X8-Production-Promotion", "value": "true"},
      {"key": "X-8X8-Financial-Sale-Open", "value": "false"},
      {"key": "X-8X8-Payment-Blocker", "value": "STRIPE-CHARGES-DISABLED-AND-SERVER-SECRET-MISSING"},
      {"key": "X-8X8-Mainnet-Live", "value": "false"}
    ]},
    {"source": "/payment(.*)", "headers": [
      {"key": "Cache-Control", "value": "no-store, max-age=0"},
      {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
      {"key": "X-8X8-Payment-Surface", "value": "STRIPE-HOSTED-CHECKOUT-RUNTIME-GATED"},
      {"key": "X-8X8-Financial-Sale-Open", "value": "false"},
      {"key": "X-8X8-Mainnet-Live", "value": "false"}
    ]},
    {"source": "/_8x8/release", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/release-identity.json", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/_8x8/telegram-release", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/telegram-release-identity.json", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/telegram(.*)", "headers": [
      {"key": "Cache-Control", "value": "no-store, max-age=0"},
      {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
      {"key": "X-8X8-Telegram-Mini-App", "value": "true"},
      {"key": "X-8X8-Release-Identity", "value": "WORLD-V4-REFERENCE-32-SURFACE-V1"},
      {"key": "X-8X8-Visual-Reference", "value": "SPATIAL-SOVEREIGN-WORLD-V4-OWNER-REFERENCE"},
      {"key": "X-8X8-Release-Channel", "value": "stable-one-fabric-telegram"},
      {"key": "X-8X8-Production-Promotion", "value": "true"},
      {"key": "X-8X8-Backend-Authority", "value": "PUBLIC-SERVERLESS-PAYMENT-HEALTH-NO-OWNER-RUNTIME"},
      {"key": "X-8X8-Public-Private-Boundary", "value": "PUBLIC-PRODUCT-NO-OWNER-RUNTIME"},
      {"key": "X-8X8-Financial-Sale-Open", "value": "false"},
      {"key": "X-8X8-Payment-Blocker", "value": "STRIPE-CHARGES-DISABLED-AND-SERVER-SECRET-MISSING"},
      {"key": "X-8X8-Mainnet-Live", "value": "false"}
    ]},
    {"source": "/r6/(.*)", "headers": [
      {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"},
      {"key": "X-8X8-Rollback-Carrier", "value": "R6-0.3.0"}
    ]},
    {"source": "/stable(.*)", "headers": [
      {"key": "Cache-Control", "value": "no-store, max-age=0"},
      {"key": "X-8X8-Release-Channel", "value": "rollback-stable-0.4.0"},
      {"key": "X-8X8-Product-Stable", "value": "past-preserved"},
      {"key": "X-8X8-Financial-Sale-Open", "value": "false"},
      {"key": "X-8X8-Mainnet-Live", "value": "false"}
    ]},
    {"source": "/api/market", "headers": [
      {"key": "Cache-Control", "value": "no-store, max-age=0"},
      {"key": "X-8X8-Trading-Authority", "value": "NONE"}
    ]},
    {"source": "/ssi(.*)", "headers": [
      {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
      {"key": "Cache-Control", "value": "no-store, max-age=0"},
      {"key": "X-8X8-Preview-Identity", "value": "SSI-R5.1-VISION-CONVERGENCE"},
      {"key": "X-8X8-Release-Channel", "value": "preview"},
      {"key": "X-8X8-Production-Promotion", "value": "false"}
    ]},
    {"source": "/genesis(.*)", "headers": [
      {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
      {"key": "Cache-Control", "value": "no-store, max-age=0"},
      {"key": "X-8X8-Preview-Identity", "value": "GENESIS-STABLE-CANDIDATE-V1"},
      {"key": "X-8X8-Release-Channel", "value": "preview"},
      {"key": "X-8X8-Production-Promotion", "value": "false"}
    ]}
  ]
}