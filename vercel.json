{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {"source":"/_8x8/release","destination":"/launch/presale-state.json"},
    {"source":"/_8x8/telegram-release","destination":"/launch/presale-state.json"},
    {"source":"/","destination":"/presale/index.html"},
    {"source":"/telegram","destination":"/presale/index.html"},
    {"source":"/telegram/","destination":"/presale/index.html"},
    {"source":"/genesis","destination":"/presale/index.html"},
    {"source":"/genesis/","destination":"/presale/index.html"},
    {"source":"/join","destination":"/join/index.html"},
    {"source":"/join/","destination":"/join/index.html"},
    {"source":"/one-fabric","destination":"/v40/index.html"},
    {"source":"/one-fabric/","destination":"/v40/index.html"},
    {"source":"/world","destination":"/v40/index.html"},
    {"source":"/world/","destination":"/v40/index.html"},
    {"source":"/discord","destination":"/v40/index.html"},
    {"source":"/discord/","destination":"/v40/index.html"},
    {"source":"/android","destination":"/v40/index.html"},
    {"source":"/android/","destination":"/v40/index.html"},
    {"source":"/ios","destination":"/v40/index.html"},
    {"source":"/ios/","destination":"/v40/index.html"},
    {"source":"/api/v40/status","destination":"/api/v40-status"},
    {"source":"/stable","destination":"/stable/index.html"},
    {"source":"/stable/","destination":"/stable/index.html"},
    {"source":"/r6","destination":"/r6/index.html"},
    {"source":"/r6/","destination":"/r6/index.html"},
    {"source":"/r5","destination":"/r5/index.html"},
    {"source":"/r5/","destination":"/r5/index.html"},
    {"source":"/cinemaproof","destination":"/cinemaproof/index.html"},
    {"source":"/cinemaproof/","destination":"/cinemaproof/index.html"},
    {"source":"/((?!api/|v40/|presale/|launch/|join/|r6/|r5/|stable/|cinemaproof/|.*\\.).*)","destination":"/v40/index.html"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Permissions-Policy","value":"payment=(), usb=(), serial=(), bluetooth=()"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'self' about:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"},
      {"key":"X-8X8-Release-Identity","value":"GENESIS-PRELAUNCH-20260910-PREVIEW"},
      {"key":"X-8X8-Canonical-Root","value":"fabric://8x8/core"},
      {"key":"X-8X8-Parent-Head","value":"4aae2fcc7b665d30bf1e93ef04b6e952f2c1bf75"},
      {"key":"X-8X8-Public-Private-Boundary","value":"PUBLIC-TENANT-CARRIER-NO-OWNER-PRIVATE-CORE"},
      {"key":"X-8X8-Launch-Mode","value":"PRELAUNCH-NON-BINDING-NO-CRYPTO-COLLECTION"},
      {"key":"Cache-Control","value":"no-store, max-age=0"}
    ]},
    {"source":"/telegram(.*)","headers":[{"key":"X-8X8-Carrier","value":"TELEGRAM"},{"key":"X-Robots-Tag","value":"noindex, nofollow"}]},
    {"source":"/presale(.*)","headers":[{"key":"X-8X8-Genesis-State","value":"INTEREST-INTENT-OPEN-SALE-FUTURE-GATED"}]},
    {"source":"/stable(.*)","headers":[{"key":"X-8X8-Product-Stable","value":"PAST_PRESERVED"}]},
    {"source":"/r6(.*)","headers":[{"key":"X-8X8-Rollback-Carrier","value":"R6"}]},
    {"source":"/r5(.*)","headers":[{"key":"X-8X8-Rollback-Carrier","value":"R5"}]}
  ]
}
